# Qdrant
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_LOG_LEVEL=INFO
QDRANT_API_KEY=replace-with-a-long-random-secret

# Teradata Vantage (external database/VM; no official database server image exists)
TERADATA_HOST=host.docker.internal
TERADATA_USER=dbc
TERADATA_PASSWORD=replace-me
TERADATA_LOGMECH=TD2
TERADATA_ENCRYPTDATA=true
TERADATASQL_VERSION=20.0.0.72

